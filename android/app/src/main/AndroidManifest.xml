<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- windowSoftInputMode=adjustResize is Capacitor's template default.
             Without an explicit mode Android chooses adjustPan for the
             (scrollable) WebView: when the soft keyboard opens over a web
             dialog — e.g. the 3D "No GPS" estimation settings with its number
             inputs — the window pans instead of resizing, the focused field
             stays hidden beneath the keyboard and typed values appear lost.
             adjustResize shrinks the WebView so the dialog
             (max-height: calc(100dvh - 2rem)) and its inputs reflow above the
             keyboard. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="userLandscape"
            android:windowSoftInputMode="adjustResize">

            <!-- Large-screen devices (Android 16+ targeting SDK 36, sw >= 600dp)
                 ignore fixed orientations by default; opt out so the viewer stays
                 landscape (the UI is desktop-sized and unusable in portrait). -->
            <property
                android:name="android.app.PROPERTY_COMPAT_ALLOW_ORIENTATION_OVERRIDE"
                android:value="false" />
            <property
                android:name="android.app.PROPERTY_COMPAT_ALLOW_DISPLAY_ASPECT_RATIO_OVERRIDE"
                android:value="false" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions: file-based viewer needs no FC transports. INTERNET stays for map tiles. -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
